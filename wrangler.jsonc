{
  // CORS proxy for the flight map. Deployed by Cloudflare Workers Builds on push to main.
  "name": "mckinney-flights-proxy",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Workers Logs: see which upstream feed failed and why (dashboard > Worker > Logs).
  "observability": { "enabled": true }
}
